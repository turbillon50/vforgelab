# Keep these values on the backend only. Never embed them in browser or Telegram JS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/vforgelab?sslmode=require
VFORGELAB_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
NEBIUS_API_KEY=replace-with-your-nebius-api-key
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
HOST=127.0.0.1
PORT=3248
NEBIUS_TIMEOUT_MS=120000
NEBIUS_MAX_TOKENS=4096
